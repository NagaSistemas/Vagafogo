<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Uma unica origem canonica mantem links e QR Codes permanentes.
  RewriteCond %{HTTP_HOST} ^www\.vagafogopiri\.com\.br$ [NC]
  RewriteRule ^ https://vagafogopiri.com.br%{REQUEST_URI} [R=301,L]

  RewriteRule ^index\.html$ - [L]

  # SPA fallback (React Router)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
