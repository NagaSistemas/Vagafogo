ASAAS_API_KEY=replace-with-asaas-api-key
ASAAS_SPLIT_WALLET_ID=replace-with-destination-wallet-id
ASAAS_SPLIT_PERCENTUAL=1
# Obrigatoria para todas as rotas de formularios (publicas e administrativas).
# Sem uma credencial valida, essas rotas respondem 503.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"banco-vagafogo","...":"..."}
NODE_ENV=production

# Origem publica canonica usada no QR permanente (somente origem, sem path/query).
# Obrigatoria e HTTPS fora de development/test. Sem ela, apenas URLs localhost
# sao aceitas, e somente quando NODE_ENV=development ou NODE_ENV=test.
PUBLIC_FORM_BASE_URL=https://www.seudominio.com.br
FORMULARIOS_RATE_LIMIT_WINDOW_MS=60000
FORMULARIOS_RATE_LIMIT_MAX=10
FORMULARIOS_GLOBAL_RATE_LIMIT_MAX=60
FORMULARIOS_QR_RATE_LIMIT_WINDOW_MS=60000
FORMULARIOS_QR_RATE_LIMIT_MAX=30
FORMULARIOS_QR_GLOBAL_RATE_LIMIT_MAX=60

# E-mails verificados (separados por virgula) autorizados a gerenciar formularios.
# Tokens com custom claim `admin: true` sao sempre aceitos. Em producao, lista
# vazia falha com ADMIN_AUTH_POLICY_NOT_CONFIGURED.
FORMULARIOS_ADMIN_EMAILS=
# Opt-in somente para development/test. Mesmo true, e ignorado em production e
# quando NODE_ENV estiver ausente. Nunca habilite em um ambiente publico.
FORMULARIOS_ALLOW_ANY_AUTHENTICATED_ADMIN=false

WHATSAPP_CLIENT_ID=disparador-agradecimento
WHATSAPP_DEVICE_NAME=Disparador Agradecimento
WHATSAPP_BROWSER_NAME=Chrome
WHATSAPP_AUTH_PATH=.wwebjs_auth
WHATSAPP_AUTO_START=false
WHATSAPP_REMOTE_BACKUP_MS=900000
WHATSAPP_IDLE_TIMEOUT_MS=600000
WHATSAPP_MAX_LIFETIME_MS=1200000
MEMORY_GUARD_MB=700
WHATSAPP_QR_IDLE_TIMEOUT_MS=300000
WHATSAPP_STARTUP_TIMEOUT_MS=90000
WHATSAPP_SEND_READY_TIMEOUT_MS=45000
WHATSAPP_INIT_RETRIES=3
WHATSAPP_INIT_RETRY_DELAY_MS=5000
PUPPETEER_EXECUTABLE_PATH=

EMAIL_PROVIDER=smtp

RESEND_API_KEY=
RESEND_FROM=Vagafogo Reservas <reservas@send.seudominio.com>
RESEND_REPLY_TO=reservasvagafogo@gmail.com
RESEND_TIMEOUT=15000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=replace-with-from-email
SMTP_FROM_NAME=Vagafogo Reservas
EMAIL_CONFIRMATION_ENABLED=false
EMAIL_DAILY_LIMIT=100
EMAIL_MONTHLY_LIMIT=3000
SMTP_MAX_RETRIES=3
SMTP_RETRY_DELAY_MS=3000
SMTP_MAX_CONNECTIONS=1
SMTP_MAX_MESSAGES=100
SMTP_CONNECTION_TIMEOUT=10000
SMTP_GREETING_TIMEOUT=7000
SMTP_SOCKET_TIMEOUT=15000
SMTP_REJECT_UNAUTHORIZED=true

WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY_MS=4000
RESERVA_CLEANUP_ENABLED=true
RESERVA_CLEANUP_WINDOW_HOURS=48
RESERVA_CLEANUP_CRON=17 * * * *
RESERVA_CLEANUP_BATCH_LIMIT=200
RESERVA_CLEANUP_LEGACY_ENABLED=true
RESERVA_CLEANUP_LEGACY_BATCH_LIMIT=200
